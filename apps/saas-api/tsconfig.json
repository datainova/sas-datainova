{
  "extends": "../../packages/tsconfig/app.json",
  "compilerOptions": {
    "rootDir": ".",
    "outDir": "dist",
    "baseUrl": "./src",
    "paths": {
      "@/config": ["config/index", "config"],
      "@/config/*": ["config/*"],
      "@/plugins/*": ["plugins/*"],
      "@/modules/*": ["modules/*"],
      "@/utils/*": ["utils/*"],
      "@/lib/*": ["lib/*"],
      "@/http/*": ["http/*"],
      "@/types/*": ["types/*"],
      "@/*": ["*"]
    }
  },
  "include": ["src", "test"],
  "exclude": ["dist", "node_modules"]
}
