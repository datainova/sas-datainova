{
  "name": "@datainova/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsup src/server.ts --format esm --dts --sourcemap",
    "start": "node dist/server.js",
    "lint": "eslint \"src/**/*.{ts,tsx}\"",
    "typecheck": "tsc --project tsconfig.json"
  },
  "dependencies": {
    "@datainova/common": "workspace:*",
    "@datainova/config": "workspace:*",
    "@datainova/database": "workspace:*",
    "@fastify/cors": "^9.0.1",
    "@fastify/cookie": "^9.1.1",
    "@fastify/rate-limit": "^9.0.0",
    "@fastify/sensible": "^5.0.1",
    "@prisma/client": "^5.9.1",
    "close-with-grace": "^1.3.0",
    "undici": "^5.28.3",
    "jose": "^5.2.2",
    "fastify": "^4.26.2",
    "fastify-type-provider-zod": "^2.1.0",
    "pg-boss": "^11.1.1",
    "pino": "^8.15.0",
    "pino-pretty": "^10.3.1",
    "nodemailer": "^6.9.16",
    "zod": "^3.22.4",
    "zod-to-json-schema": "^3.22.0"
  },
  "devDependencies": {
    "@types/node": "^20.11.17",
    "tsup": "^7.2.0",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3"
  }
}
