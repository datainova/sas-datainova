# Core application
NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://username:password@localhost:5432/datainova
FRONTEND_URL=http://localhost:5173

# Authentication
JWT_PUBLIC_KEY=-----BEGIN PUBLIC KEY-----\nreplace-with-public-key\n-----END PUBLIC KEY-----
JWT_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\nreplace-with-private-key\n-----END PRIVATE KEY-----
JWT_ISSUER=datainova-saas
AGENT_SIGNING_SECRET=replace-with-32-char-min-secret
AUTH_PASSWORD_PEPPER=replace-with-32-char-min-secret
# Optional overrides (defaults aplicados se omitidos)
# AUTH_ACCESS_TOKEN_TTL_SEC=900
# AUTH_REFRESH_TOKEN_TTL_DAYS=30
# AUTH_SIGNUP_TOKEN_TTL_MINUTES=60
# AUTH_RESET_TOKEN_TTL_MINUTES=60

# Email (envio transacional)
EMAIL_SMTP_HOST=smtp.office365.com
EMAIL_SMTP_PORT=587
EMAIL_SMTP_SECURE=false
EMAIL_SMTP_USER=thiago.souza@datainova.com.br
EMAIL_SMTP_PASSWORD=replace-with-email-password
EMAIL_FROM_ACCOUNT=thiago.souza@datainova.com.br
# Ajuste os aliases conforme desejado; se omitidos, o backend usa EMAIL_FROM_ACCOUNT
EMAIL_FROM_SIGNUP=onboarding@datainova.com.br
EMAIL_FROM_RECOVERY=recovery@datainova.com.br

# Google OIDC (habilita “Entrar com Google”)
# GOOGLE_CLIENT_ID=58646643845-q7ur6297lhacmo1mluib93qkcjqghrvk.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=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
# GOOGLE_REDIRECT_URI=http://localhost:3333/auth/oidc/google/callback

# Optional integrations
# CHROMA_URL=https://chroma.example.com
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_SECRET_KEY=sk_live_...
# HUBSPOT_WEBHOOK_SECRET=hssec_...
# HUBSPOT_ACCESS_TOKEN=pat-...
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...

# Observability
# OTEL_EXPORTER_OTLP_ENDPOINT=https://otel-collector.example.com

# Rate limiting (requests por minuto)
RATE_LIMIT_PER_MIN=120
